quality_plot <- amazon_words |>
# Filtering out product types with less than 1000 ratings
filter(product_type %out% c("AVReceivers&Amplifiers", "SATACables", "3DGlasses",
"Earpads", "StovetopEspressoPots", "YogurtMakers",
"StandMixers", "ElectricGrinders", "ColouredPaper",
"RotiMakers", "InternalHardDrives", "TraditionalLaptops",
"PhoneCharms", "TowerSpeakers", "StreamingClients")) |>
mutate(is_quality = ifelse(word == "quality", 1, 0)) |>
group_by(product_type) |>
summarise(
is_quality = sum(is_quality),
all_words = n(),
.groups = "drop") |>
mutate(quality_pc = is_quality / all_words) |>
left_join(
amazon |>
group_by(product_type, category) |>
summarise(mean_discounted_price = mean(discounted_price, na.rm = TRUE),
mean_discount = mean(discount_percentage, na.rm = TRUE),
.groups = "drop"),
by = "product_type"
) |>
ggplot(aes(x = mean_discounted_price, y = quality_pc)) +
geom_smooth(method = "lm", alpha = .3) +
geom_point(aes(colour = category,
text = paste0(
"Product type: ", product_type, ",", "\n",
"Category: ", category, ",", "\n",
"Mean discounted price (USD): ", round(mean_discounted_price, 2), ",", "\n",
"Mean discount: ", round(mean_discount * 100, 2), "%"
))) +
scale_x_log10(breaks = c(1, 3, 10, 30, 100, 300)) +
scale_colour_viridis_d(option = "turbo") +
scale_y_continuous(labels = percent) +
labs(
title = "Percentage of review text mentioning 'Quality'",
x = "Mean discounted price in USD",
y = "% of words in reviews that are 'Quality'",
colour = "Double-click to\nselect or reset"
)
